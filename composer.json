{
    "name": "derafu/symfony-translation-bundle",
    "description": "Derafu: Symfony Translation Bundle - Translation resources for Symfony applications",
    "type": "symfony-bundle",
    "homepage": "https://www.derafu.dev/docs/symfony/translation-bundle",
    "license": "MIT",
    "authors": [
        {
            "name": "Esteban De La Fuente Rubio / Derafu",
            "homepage": "https://www.derafu.dev"
        }
    ],
    "support": {
        "issues": "https://github.com/derafu/symfony-translation-bundle/issues",
        "source": "https://github.com/derafu/symfony-translation-bundle"
    },
    "autoload": {
        "psr-4": {
            "Derafu\\TranslationBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Derafu\\TestsTranslationBundle\\": "tests/src/",
            "Derafu\\TestsTranslationBundle\\Fixture\\": "tests/fixtures/"
        }
    },
    "require": {
        "php": "^8.5",
        "derafu/translation": "dev-main",
        "psr/container": "^2.0",
        "symfony/config": "^8.1",
        "symfony/dependency-injection": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/http-kernel": "^8.1",
        "symfony/translation": "^8.1",
        "symfony/yaml": "^8.1"
    },
    "require-dev": {
        "ext-xdebug": "*",
        "friendsofphp/php-cs-fixer": "^3.95",
        "phpstan/phpstan": "^2.3",
        "phpunit/phpunit": "^13.4",
        "symfony/process": "^8.1"
    },
    "scripts": {
        "tests": "XDEBUG_MODE=coverage vendor/bin/phpunit --configuration=phpunit.xml",
        "phpcs-fix": "vendor/bin/php-cs-fixer fix -v --config=php-cs-fixer.php",
        "phpcs": "vendor/bin/php-cs-fixer fix -v --dry-run --diff --config=php-cs-fixer.php",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon --memory-limit=1G"
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
